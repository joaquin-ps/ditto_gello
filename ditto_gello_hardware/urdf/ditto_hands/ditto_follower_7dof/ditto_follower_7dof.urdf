<?xml version="1.0"?>
<robot name="ditto_follower_7dof">
  <!--
  DITTO 7-DoF follower hand on the xArm flange. Generated by scripts/build_ditto_hand.py from
  manipulation_env's 7_dof_assembly_urdf (SolidWorks export, joints edited to ditto's angles);
  do not edit by hand.

  mme.safety.collision appends this model to xarm7.urdf with hand_mount rigidly at link7 (the
  bare flange, before the rig's tcp_offset). hand_mount -> palm is the mount: the 10 mm connector
  (a cylinder on hand_mount) and the hand's rotation about the flange axis (see the
  script). Finger joint angles are ditto follower angles
  (rad, the DITTO service's q); limits are the follower limits of ditto's 7dof config.

  Visual meshes are decimated; collision meshes are convex hulls (the palm in parts). Pairs
  within the hand are not checked: the guard protects the hand from the arm and the table.
-->
  <material name="ditto_grey">
    <color rgba="0.30 0.30 0.33 1" />
  </material>
  <link name="hand_mount">
    <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0375" length="0.01" />
      </geometry>
      <material name="ditto_grey" />
    </visual>
    <collision>
      <origin xyz="0 0 0.005" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0375" length="0.01" />
      </geometry>
    </collision>
  </link>
  <joint name="hand_mount_to_palm" type="fixed">
    <origin xyz="0 0 0.01" rpy="0 1.570796327 1.570796327" />
    <parent link="hand_mount" />
    <child link="palm" />
  </joint>
  <link name="palm">
    <inertial>
      <origin xyz="-0.0154696232096144 -0.0201884369334062 -0.0192844443455349" rpy="0 0 0" />
